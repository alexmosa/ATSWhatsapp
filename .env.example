# Aplicación
APP_NAME=ATS WhatsApp Reclutamiento
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Base de datos
DATABASE_URL=sqlite:///./data/ats.db

# OpenAI (motor conversacional del agente)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Twilio WhatsApp Business API
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Google Calendar (Opción C - integración a medida)
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials/google_credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=credentials/google_token.json

# Webhook
WEBHOOK_BASE_URL=https://your-domain.com

# Reclutador por defecto
DEFAULT_RECRUITER_NAME=Equipo de Atracción de Talento
DEFAULT_COMPANY_NAME=Tu Empresa
